<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
        Kabadiwala Connect Network Security Config
        All production traffic goes over HTTPS to onrender.com backend.
        Localhost (127.0.0.1) is allowed in cleartext for local dev only.
    -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <!-- Allow HTTP only to localhost for Capacitor dev live-reload -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
        <domain includeSubdomains="true">10.0.2.2</domain>
    </domain-config>
</network-security-config>
