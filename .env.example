# ─── Kabadiwala Connect — Environment Variables ────────────────────────────
# Copy this to .env (ignored by git) and fill in actual values

# ── Frontend (Vite) ─────────────────────────────────────────────────────────
# The deployed Render backend URL. Set this in Vercel project settings too.
VITE_API_BASE_URL=https://kabadiwala-api.onrender.com

# Optional: Piper TTS voice model override
# VITE_PIPER_HI_VOICE=hi_IN-female-medium
# VITE_PIPER_MR_VOICE=mr_IN-female-medium

# ── Backend (FastAPI / Render) ───────────────────────────────────────────────
# Render provides DATABASE_URL automatically when a database is linked.
# For local dev with Supabase, get this from your Supabase project > Settings > Database > Connection string (URI)
DATABASE_URL=postgresql://user:password@host:5432/kabadiwala

# JWT signing secret — generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-strong-random-secret

# Environment flag
ENVIRONMENT=development
